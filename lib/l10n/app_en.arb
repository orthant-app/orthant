  "settingsTabGeneral": "General",
  "@settingsTabGeneral": {
    "description": "The Settings window's first tab, for everything that is not a keyboard shortcut. On macOS it is also the name of a System Settings pane, so use Apple's word for General."
  },
  "settingsTabShortcuts": "Shortcuts",
  "@settingsTabShortcuts": {
    "description": "The Settings window's second tab, the list of keyboard shortcuts."
  },
  "settingsTabAbout": "About",
  "@settingsTabAbout": {
    "description": "The Settings window's third tab, showing the version and the update check."
  },
  "settingsTabLabel": "{tab} tab",
  "@settingsTabLabel": {
    "description": "What a screen reader calls one tab of the Settings window. Never drawn on screen. {tab} is the tab's name, written by the three messages above.",
    "placeholders": {
      "tab": {
        "type": "String",
        "example": "General"
      }
    }
  },
  "generalGroupAccessibility": "Accessibility",
  "@generalGroupAccessibility": {
    "description": "The label of the General tab's row that shows whether Orthant has the macOS Accessibility permission. It is the name of a macOS Privacy & Security pane, so use Apple's word for Accessibility. Shown on macOS only."
  },
  "generalGroupOpenGrid": "Open grid",
  "@generalGroupOpenGrid": {
    "description": "The label of the General tab's row that shows the shortcut which opens the grid."
  },
  "generalGroupGrid": "Grid",
  "@generalGroupGrid": {
    "description": "The label of the General tab's group of two steppers that set the grid's columns and rows."
  },
  "generalGroupGaps": "Gaps",
  "@generalGroupGaps": {
    "description": "The label of the General tab's group that sets the space left between windows and the screen's edge when a window is placed."
  },
  "generalGroupStartup": "Startup",
  "@generalGroupStartup": {
    "description": "The label of the General tab's group holding the launch-at-login checkbox."
  },
  "generalColumns": "Columns",
  "@generalColumns": {
    "description": "The caption of the General tab's stepper for the number of columns in the grid. A column runs top to bottom. Keep it short: the caption has room for about five characters."
  },
  "generalRows": "Rows",
  "@generalRows": {
    "description": "The caption of the General tab's stepper for the number of rows in the grid. A row runs left to right. Keep it short: the caption has room for about five characters."
  },
  "generalGapSize": "Size",
  "@generalGapSize": {
    "description": "The caption of the General tab's stepper for how large a gap is, beside the unit (pt on macOS, px on Windows)."
  },
  "generalLeaveGaps": "Leave gaps",

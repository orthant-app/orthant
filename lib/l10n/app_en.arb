    "description": "The label of the General tab's checkbox that turns gaps between placed windows and the screen's edge on or off."
  },
  "generalResetGridAndGaps": "Reset Grid & Gaps",
  "@generalResetGridAndGaps": {
    "description": "The button at the foot of the General tab that puts the grid size and the gaps back to their defaults. It changes nothing else, and the name says so."
  },
  "generalAccessibilityGranted": "Granted",
  "@generalAccessibilityGranted": {
    "description": "Beside a green dot on the General tab, when Orthant has the macOS Accessibility permission. Shown on macOS only."
  },
  "generalAccessibilityNotGranted": "Not granted. Shortcuts and the grid do nothing",

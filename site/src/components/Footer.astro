---
const links = [
  { href: 'https://github.com/orthant-app/orthant', label: 'GitHub' },
  { href: 'https://github.com/orthant-app/orthant/issues', label: 'Report an issue' },
  { href: '/docs/', label: 'Docs' },
  { href: '/docs/troubleshooting/', label: 'Troubleshooting' },
  { href: '/privacy/', label: 'Privacy' },
  { href: 'https://github.com/orthant-app/orthant/blob/main/LICENSE', label: 'MIT licence' },
];
---
<footer class="wrap section">
  <ul>
    {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
  </ul>
  <p class="quiet">
    © Optimal One · Orthant is free and open source, with no paid tier.
  </p>
</footer>

<style>
  footer { padding-block: 40px 56px; }
  /*
   * A list, not a "·"-joined sentence. The separators were literal middots in
   * the markup, and the newline before each one collapsed to a space while the
   * one after it did not — the footer rendered "Report an issue ·Privacy ·MIT".
   */
  ul { display: flex; flex-wrap: wrap; gap: 8px 22px; list-style: none; margin: 0 0 14px; padding: 0; }
  a { display: inline-block; padding-block: 5px; color: var(--label-secondary); text-decoration: none; font-size: 15px; }
  a:hover { color: var(--label); text-decoration: underline; }
  .quiet { color: var(--label-secondary); font-size: 14px; margin: 0; max-width: 62ch; }
</style>

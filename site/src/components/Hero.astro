---
// No gridBlock call here: the resting selection is a constant, and CSP forbids
// interpolating it into a style attribute (see the .preview rule below).
const COLS = 4;
const ROWS = 3;
const rows = Array.from({ length: ROWS }, (_, r) => r);
const cols = Array.from({ length: COLS }, (_, c) => c);
---
<section class="hero wrap">
  <div class="copy">
    <p class="eyebrow">A window manager for macOS</p>
    <h1>Draw where a window should go. Give it a shortcut.</h1>
    <p class="lede">
      Halves and quarters on keys, like everything else. Then draw any region you
      want, name it, and bind it. Free and open source.
    </p>

    <div class="cta">
      <a class="btn btn-primary" href="/download">Download for macOS 13+</a>
      <a class="btn btn-secondary" href="#see-it-work">See it work</a>
    </div>
  </div>

  <figure class="demo">
    {/* A macOS screen, drawn in CSS. No screenshot: nothing to go stale, and
        nothing that could carry a real menu bar, wallpaper or third-party app. */}
    <div class="scene">
      <div class="bar" aria-hidden="true">
        <span class="bar-app">Safari</span>
        <img src="/icon.svg" width="12" height="12" alt="" />
      </div>
      <div class="desktop">
        <div class="win win-back win-b" aria-hidden="true"><span>Terminal</span></div>
        <div class="win win-back win-c" aria-hidden="true"><span>Notes</span></div>

        {/* The window that actually LANDS. It sits where it currently is and
            moves only on commit, which is what the app does: the overlay
            previews, the window moves when you release or press Return. */}
        <div id="hero-placed" class="win win-front" aria-hidden="true"><span>Safari</span></div>

        {/* The true-scale preview: where the window WILL land, at real size and
            position. Its resting geometry is a CSS constant, asserted against
            gridBlock by hero-default.test.ts. */}
        <div id="hero-window" class="preview" aria-hidden="true"></div>

        {/* The compact panel: a scale model of the display, centred, with the
            captured app's name above the cells. This is `_panelRect`. */}
        <div class="panel">
          <div class="chip" aria-hidden="true">Safari</div>
          <div
            id="hero-grid"
            class="grid"
            data-cols={COLS}
            data-rows={ROWS}
            aria-describedby="hero-hint"
          >
            {rows.map((r) => (
              <div class="row" data-row={r}>
                {cols.map((c) => (
                  <div class="cell" id={`hero-cell-${c}-${r}`} data-col={c} data-row={r}></div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <figcaption>
      <p id="hero-readout" class="annot">left half · 1/2 × 1 of the screen</p>
      <p id="hero-hint" class="hint">
        Drag across the grid, or focus it and use the arrow keys.
      </p>
      <ul class="keys">
        <li><kbd>⇧</kbd> extends</li>
        <li><kbd>↩</kbd> places</li>
        <li><kbd>Esc</kbd> resets</li>
      </ul>
    </figcaption>
    <p id="hero-status" class="visually-hidden" role="status" aria-live="polite"></p>
  </figure>
</section>

<style>
  /*
   * `minmax(0, 1fr)` on the single-column case too, not just the two-column
   * one. A bare `auto` grid track is floored at its min-content width, and the
   * install command cannot wrap below ~400px — so at 390px the track pushed
   * the whole PAGE to 450px wide and every section inherited a horizontal
   * scrollbar. The floor has to be removed wherever the track exists.
   */
  .hero {
    padding-block: 40px 64px;
    display: grid; grid-template-columns: minmax(0, 1fr);
    gap: 40px; align-items: center;
  }
  /* Equal columns, and not before 980px: the install command is 41 monospace
     characters plus a Copy button, and a narrower column clips it — which
     reads as a broken command rather than a narrow box. */
  @media (min-width: 980px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; }
  }

  h1 {
    font-size: clamp(32px, 3.2vw, 44px);
    line-height: 1.08; letter-spacing: -0.025em;
    margin: 0 0 14px; max-width: 16ch;
  }
  .lede { font-size: 19px; color: var(--label-secondary); margin: 0 0 24px; max-width: 34ch; }
  .cta { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }

  .demo { margin: 0; }
  .eyebrow {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--label-secondary); margin: 0 0 10px;
  }

  .scene {
    border: 1px solid var(--rule);
    border-radius: 12px; overflow: hidden;
    background: var(--raised);
  }
  .bar {
    height: 24px; display: flex; align-items: center; justify-content: space-between;
    padding-inline: 10px; border-bottom: 1px solid var(--separator);
    background: var(--surface); font-size: 11px; color: var(--label-secondary);
  }
  .bar-app { font-weight: 600; color: var(--label); }
  .bar img { display: block; opacity: 0.85; }

  .desktop { position: relative; aspect-ratio: 16 / 10; }

  .win {
    position: absolute;
    border: 1px solid var(--separator); border-radius: 6px;
    background: var(--surface); overflow: hidden;
  }
  .win span {
    display: block; height: 18px; line-height: 18px; padding-inline: 8px;
    border-bottom: 1px solid var(--separator); background: var(--raised);
    font-size: 10.5px; color: var(--label-secondary);
  }
  .win-back { opacity: 0.5; }
  .win-b { left: 56%; top: 8%; width: 38%; height: 42%; }
  .win-c { left: 62%; top: 54%; width: 32%; height: 38%; }
  /* The window as it is now, before the placement lands. */
  .win-front { left: 12%; top: 18%; width: 44%; height: 58%; }

  /*
   * The true-scale preview: real size, real position, which is what the app
   * draws while you drag. Its resting geometry is a CONSTANT in CSS, not an
   * inline style attribute — `style-src 'self'` drops style attributes, so an
   * authored one would collapse the preview to nothing with JavaScript off.
   * The JS path writes .style through the CSSOM, which CSP does not block.
   *
   * hero-default.test.ts asserts these four numbers are gridBlock's output for
   * the left half at cols 4, rows 3, gap 12 on a 1600x1000 frame.
   */
  .preview {
    position: absolute;
    left: 0.75%;
    top: 1.2%;
    width: 48.875%;
    height: 97.6%;
    border: 1.5px solid var(--accent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    z-index: 1;
    pointer-events: none;
  }

  /*
   * The panel: a compact scale model of the display, centred, chip above the
   * cells. Not a grid over the whole screen — see grid_overlay.dart:10.
   * The proportions mirror the app's own chrome constants: 9pt padding,
   * a 16pt chip row and an 8pt gap, expressed here as a share of the panel.
   */
  .panel {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 46%;
    padding: 6px;
    border-radius: 10px;
    background: rgb(16 22 34 / 0.78);
    z-index: 2;
  }
  .chip {
    height: 15px; line-height: 15px;
    margin-bottom: 5px;
    text-align: center;
    color: #fff; font-size: 10.5px; font-weight: 600;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  .grid {
    position: relative; aspect-ratio: 16 / 10;
    display: flex; flex-direction: column; gap: 1px;
    background: rgb(255 255 255 / 0.22);
    border-radius: 4px; overflow: hidden;
    /* ⚠️ Load-bearing, and easy to drop while rewriting this rule: a vertical
       swipe must scroll the page rather than drag a selection. Verified once
       with a real CDP touch swipe (page scrolled 360px, grid untouched); the
       pointercancel handler in hero.ts is the other half. */
    touch-action: pan-y;
  }
  .grid:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .row { display: flex; flex: 1; gap: 1px; }
  .cell { flex: 1; background: rgb(16 22 34 / 0.55); }
  .cell[aria-selected='true'] { background: color-mix(in srgb, var(--accent) 72%, transparent); }

  /* The resting selection, for the no-JS case. paint() takes over the moment
     the controller attaches, so this retires itself on `data-ready` rather
     than fighting the live state. At cols=4 the left half is the first two
     cells of every row; hero-default.test.ts ties that count to gridBlock's
     own default so the two cannot drift. */
  .grid:not([data-ready]) .row .cell:nth-child(-n + 2) {
    background: color-mix(in srgb, var(--accent) 72%, transparent);
  }

  /*
   * The affordance the demo was missing entirely: nothing said the grid could
   * be touched, so it read as a static diagram. Only applied once the
   * controller has attached — a crosshair over an inert box is a lie.
   */
  .grid[data-ready] .cell { cursor: crosshair; }
  .grid[data-ready] .cell:hover { background: color-mix(in srgb, var(--accent) 34%, rgb(16 22 34 / 0.55)); }

  /* The landed state. Return says "places it", so pressing it has to do
     something a sighted visitor can see; the live region alone left the key
     looking broken. */
  .win-front[data-placed] { border-color: var(--accent); }
  .win-front[data-placed] span { background: color-mix(in srgb, var(--accent) 22%, var(--surface)); }

  figcaption { margin-top: 14px; }
  .hint { color: var(--label-secondary); font-size: 14px; margin: 6px 0 0; }
  .keys {
    display: flex; flex-wrap: wrap; gap: 6px 18px;
    list-style: none; margin: 8px 0 0; padding: 0;
    color: var(--label-secondary); font-size: 14px;
  }
  /* nowrap is the whole point: a keycap must never end a line with its verb on
     the next one. */
  .keys li { display: flex; align-items: center; gap: 6px; white-space: nowrap; }

  @media (prefers-reduced-motion: no-preference) {
    .preview { transition: left .16s ease, top .16s ease, width .16s ease, height .16s ease; }
    .win-front { transition: left .2s ease, top .2s ease, width .2s ease, height .2s ease; }
  }
</style>

<script>
  import { attachHero } from '../lib/hero';
  const root = document.querySelector<HTMLElement>('.hero');
  if (root) attachHero(root);
</script>

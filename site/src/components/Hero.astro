---
// No gridBlock call here: the dormant selection is a constant, and CSP forbids
// interpolating it into a style attribute (see the .window rule below).
const COLS = 4;
const ROWS = 3;
const rows = Array.from({ length: ROWS }, (_, r) => r);
const cols = Array.from({ length: COLS }, (_, c) => c);
---
<section class="hero wrap">
  <h1>Snap windows. Or draw exactly where they go.</h1>
  <p class="lede">
    A grid-based window manager for macOS. Free and open source.
  </p>

  <div class="cta">
    <a class="button" href="/download">Download for macOS 13+</a>
    <code>brew install --cask orthant-app/tap/orthant</code>
  </div>
  <p class="quiet">Windows support is planned. Linux is not possible — Wayland does not let one app move another's windows.</p>

  <div id="hero-grid" class="grid" data-cols={COLS} data-rows={ROWS}>
    {rows.map((r) => (
      <div class="row" data-row={r}>
        {cols.map((c) => (
          <div class="cell" id={`hero-cell-${c}-${r}`} data-col={c} data-row={r}></div>
        ))}
      </div>
    ))}
    <div id="hero-window" class="window"></div>
  </div>

  <p id="hero-caption" class="caption">
    Press <kbd>⌃⌥O</kbd> and the grid appears over every display in about 50 milliseconds.
    Drag across cells to place the frontmost window.
  </p>

  <!-- Hidden until the controller loads: a button that does nothing is worse
       than no button. Task 10's script removes `hidden`. -->
  <button id="hero-activate" type="button" hidden>Try the grid</button>
  <p id="hero-instructions" class="instructions" hidden>
    Arrows move · <kbd>⇧</kbd> extends · <kbd>↩</kbd> places · <kbd>Esc</kbd> exits
  </p>
  <p id="hero-status" class="visually-hidden" role="status" aria-live="polite"></p>
</section>

<style>
  .hero { padding: 56px 0 72px; }
  h1 { font-size: clamp(32px, 5vw, 52px); line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 16px; max-width: 18ch; }
  .lede { font-size: 20px; color: var(--label-secondary); margin: 0 0 28px; }
  .cta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .button { background: var(--accent); color: #fff; padding: 11px 20px; border-radius: 8px; text-decoration: none; font-weight: 550; }
  .quiet { color: var(--label-secondary); font-size: 15px; margin-top: 12px; }

  .grid {
    position: relative;
    aspect-ratio: 16 / 10;
    margin: 40px 0 16px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--separator);
    border: 1px solid var(--separator);
    border-radius: 10px;
    overflow: hidden;
    touch-action: pan-y; /* vertical swipes scroll the page; only drags select */
  }
  .grid:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .row { display: flex; flex: 1; gap: 1px; }
  .cell { flex: 1; background: var(--surface); }
  .cell[aria-selected='true'] { background: color-mix(in srgb, var(--accent) 8%, var(--surface)); }

  /*
   * The dormant selection is a CONSTANT, so it lives in CSS.
   *
   * It cannot be an inline `style` attribute: the site's CSP sets
   * `style-src 'self'`, and CSP governs style ATTRIBUTES as well as <style>
   * elements — the browser is required to ignore a disallowed one. The window
   * would collapse to zero size with JavaScript disabled, which is precisely
   * the guarantee this component exists to make. Worse, the JS path sets
   * `.style` through the CSSOM, which CSP does NOT block, so the interactive
   * hero would look fine while the no-JS hero was silently broken.
   *
   * hero-default.test.ts asserts these four numbers are gridBlock's output for
   * the left half at cols 4, rows 3, gap 12 on a 1600x1000 frame.
   */
  .window {
    position: absolute;
    left: 0.75%;
    top: 1.2%;
    width: 48.875%;
    height: 97.6%;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    border: 1.5px solid var(--accent);
    border-radius: 6px;
    pointer-events: none;
  }
  .caption { color: var(--label-secondary); font-size: 15px; }
  .instructions { color: var(--label-secondary); font-size: 15px; }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .window { transition: left .12s ease, top .12s ease, width .12s ease, height .12s ease; }
  }
</style>

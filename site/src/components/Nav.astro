---
interface Props { path: string }
const { path } = Astro.props;

const links = [
  { href: '/docs/', label: 'Docs' },
  { href: '/changelog/', label: 'Changelog' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/compare/', label: 'Compare' },
  { href: 'https://github.com/orthant-app/orthant', label: 'GitHub' },
];

// A section, not an exact page: /docs/shortcuts/ should mark "Docs".
const current = (href: string) => href.startsWith('/') && path.startsWith(href);
---
<nav class="wrap nav" aria-label="Primary">
  <a class="brand" href="/">
    <img src="/icon.svg" width="26" height="26" alt="" />
    <span>Orthant</span>
  </a>
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>
      </li>
    ))}
  </ul>
  <a class="btn btn-primary nav-cta" href="/download">Download</a>
</nav>

<style>
  .nav {
    display: flex; align-items: center; flex-wrap: wrap;
    gap: 10px 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--separator);
  }
  .brand {
    display: inline-flex; align-items: center; gap: 9px;
    font-weight: 600; font-size: 17px;
    text-decoration: none; color: var(--label);
    margin-right: auto;
  }
  .brand img { display: block; border-radius: 6px; }

  ul { display: flex; list-style: none; margin: 0; padding: 0; gap: 8px 20px; }
  ul a {
    display: inline-block; padding-block: 6px;
    color: var(--label-secondary); text-decoration: none;
  }
  ul a:hover { color: var(--label); }
  ul a[aria-current='page'] { color: var(--label); font-weight: 550; }
  .nav-cta { padding: 7px 15px; font-size: 15px; }

  /*
   * A designed small-screen state, not flex-wrap's leftovers.
   *
   * Below 720px the links take their own full-width row under the brand and
   * the download button, and that row is an EVEN GRID rather than a wrapping
   * flex line. The wrapping version stranded "GitHub" alone on a third row at
   * 390px and got worse at 320px: five items of unequal width packed greedily
   * always orphan the last one. Five equal columns cannot orphan anything.
   */
  @media (max-width: 719px) {
    ul {
      order: 3; width: 100%;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0;
      border-top: 1px solid var(--separator);
      padding-top: 6px;
    }
    ul li { display: flex; justify-content: center; }
    ul a { padding: 7px 2px; font-size: 13px; text-align: center; }
  }

  /* At 320px five columns of 13px text still fit (the longest label,
     "Changelog", measures under 56px), but there is no slack left, so the
     labels lose their letter-spacing rather than the row losing a column. */
  @media (max-width: 359px) {
    ul a { font-size: 12px; letter-spacing: -0.01em; }
  }
</style>

---
import { FACTS } from '../lib/facts';
---
<div class="band">
  <ul class="strip wrap">
    {FACTS.map((f) => (
      <li>
        <span class="value">{f.value}</span>
        <span class="note">{f.note}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .band { border-block: 1px solid var(--separator); background: var(--raised); }
  /*
   * A grid, not a wrapping flex row: equal tracks put every figure in a column
   * aligned with the one above it. A wrapping row packs each line as full as it
   * goes, so nothing lines up and the strip reads as a run-on sentence.
   */
  .strip {
    display: grid;
    /* Two columns below 500px: auto-fit alone gives ONE column at 320px (two
       150px tracks plus the gap do not fit a 272px content box), which is the
       single-column wall the design gate flagged. minmax(0, …), not a bare
       auto-fit floor — see the identical note in Hero.astro's .hero rule. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 16px;
    list-style: none; margin-block: 0; padding-block: 18px;
  }
  /*
   * One column when two would not fit their own text.
   *
   * The responsive floor is 320px, so nothing supported reaches here: this is
   * for 200% zoom on a small phone, where a 390px viewport becomes 195px of
   * CSS and two columns give ~66px cells for ~80px of content, overlapping
   * "No telemetry" onto "macOS 13+". Below 260px, two columns cannot hold the
   * longest value, so there is no width at which this rule costs anything.
   */
  @media (max-width: 260px) {
    .strip { grid-template-columns: minmax(0, 1fr); }
  }
  @media (min-width: 500px) {
    .strip { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px 24px; }
  }
  li { display: flex; flex-direction: column; gap: 1px; }
  .value {
    font-family: var(--font-mono); font-size: 15px; font-weight: 600;
    color: var(--label); letter-spacing: -0.01em;
  }
  .note { font-size: 12.5px; color: var(--label-secondary); }
</style>

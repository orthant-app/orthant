---
import Base from '../layouts/Base.astro';
---
<Base
  title="Not found · Orthant"
  description="That page does not exist."
  path="/404/"
>
  <div class="wrap prose">
    <p class="code">404</p>
    <h1>That page isn't here.</h1>
    <p>It may have moved, or the link may be wrong. These are the ones people usually want:</p>
    <ul>
      <li>
        <a href="/">Home</a>
        <span>What Orthant does, and how to install it</span>
      </li>
      <li>
        <a href="/docs/">Documentation</a>
        <span>Shortcuts, the grid, custom regions, settings</span>
      </li>
      <li>
        <a href="/docs/troubleshooting/">Troubleshooting</a>
        <span>Accessibility permission problems</span>
      </li>
      <li>
        <a href="https://github.com/orthant-app/orthant/issues">GitHub Issues</a>
        <span>If something is broken</span>
      </li>
    </ul>
  </div>
</Base>

<style>
  .code { font-family: var(--font-mono); color: var(--label-secondary); margin: 48px 0 0; }
  h1 { margin: 4px 0 16px; }
  /* Link above, description below, rather than the two joined by a dash. The
     description then wraps under itself instead of under the link, which is
     what made these read as one long line on a phone. */
  ul { list-style: none; padding: 0; margin: 0; }
  li { padding: 10px 0; border-bottom: 1px solid var(--separator); }
  li:last-child { border-bottom: 0; }
  li span { display: block; color: var(--label-secondary); font-size: 15px; }
</style>

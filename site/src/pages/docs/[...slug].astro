---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocsNavList from '../../components/DocsNavList.astro';
import { docsGroups, docsSequence } from '../../lib/docs';

export async function getStaticPaths() {
  const pages = await getCollection('docs');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);

// Every doc, in reading order, so a page can offer the next one and the
// sidebar can show where you are. A back link to the index was the only
// navigation between nine pages: finding the page after this one meant going
// up and coming back down.
//
// Both come from lib/docs, which the /docs/ index renders too, so the sidebar
// and the index cannot disagree about order or membership.
const all = await getCollection('docs');
const groups = docsGroups(all);
// NOT a flat `order` sort: `order` restarts inside each group, so sorting on
// it alone interleaves the groups and sends the reader backwards. Measured
// before this changed: 6 of 9 pages had a wrong "next".
const sequence = docsSequence(all);
const index = sequence.findIndex((p) => p.id === page.id);
const next = sequence[index + 1];
---
<Base title={`${page.data.title} · Orthant`} description={page.data.description} path={`/docs/${page.id}/`}>
  <div class="wrap docs">
    {/* One nav, one list, in source order before the article: right for a
        screen reader and for desktop. On a phone the <details> collapses it to
        a single line, so a sibling page is reachable from the TOP of the page
        without nine links standing between the reader and what they asked for.
        No JavaScript: `script-src 'self'` has no unsafe-inline, and a script
        for nine links would not earn its place. */}
    <nav class="toc" aria-label="Documentation">
      {/* Two renderings of one list, with exactly one `display: none` at any
          width. The list markup itself is not duplicated — DocsNavList is.

          ⚠️ This replaced a single <details> that stayed CLOSED on desktop
          while CSS (`::details-content { content-visibility: visible }`) forced
          its contents visible. Measured: WebKit showed nine links on screen and
          exposed ZERO of them in the accessibility tree; Chromium exposed all
          nine. Setting `open` restored them in WebKit. The `open` attribute is
          the element's own state, and an engine is free to derive semantics
          from it rather than from computed style — so overriding the
          appearance in CSS produced a nav that looked complete and was empty to
          a screen reader, on the engine this audience actually uses.

          `display: none` is the one hiding mechanism no engine disagrees
          about. The cost is nine duplicated <a> elements in the HTML; if CSS
          fails entirely both lists render, which is ugly but navigable. */}
      <details class="toc-disclosure">
        {/* The count comes from the collection. Hardcoding "9" would quietly
            start lying the first time a tenth page is added. */}
        <summary>Documentation · {sequence.length} pages · you are on {page.data.title}</summary>
        <DocsNavList groups={groups} current={page.id} />
      </details>
      <div class="toc-static">
        <DocsNavList groups={groups} current={page.id} />
      </div>
    </nav>

    <article class="prose">
      <h1>{page.data.title}</h1>
      <Content />
      {next && (
        <a class="next" href={`/docs/${next.id}/`}>
          <span class="next-label">Next</span>
          <span class="next-title">{next.data.title} →</span>
        </a>
      )}
    </article>
  </div>
</Base>

<style>
  /* `minmax(0, 1fr)`, not the default `auto`: an auto track is floored at its
     min-content width, and a wide table inside would push the page out. */
  .docs {
    padding-block: 32px 72px;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px;
  }

  /*
   * The sidebar sits FIRST on a phone now, where it used to be pushed after
   * the article with `order`. That earlier fix solved "nine links before the
   * content you asked for" and created a worse problem: the only route to a
   * sibling page was below the whole article. Collapsed to one line by the
   * <details>, it costs a single row and is reachable immediately, so source
   * order and visual order agree at every width.
   */
  .toc { border-bottom: 1px solid var(--separator); padding-bottom: 16px; }

  @media (min-width: 900px) {
    .docs { grid-template-columns: 216px minmax(0, 1fr); gap: 48px; }
    .toc {
      border-bottom: 0; padding-bottom: 0;
      /* Long pages scroll past the whole list otherwise, which is most of what
         a sidebar is for. */
      position: sticky; top: 24px; align-self: start;
    }
  }

  /*
   * The disclosure is a MOBILE control only, and above 900px it is removed from
   * the document rather than overridden — see the comment on the markup. The
   * static list is its desktop counterpart, and the two are never both present.
   *
   * ⚠️ Checking this by eye, or with `getBoundingClientRect()`, cannot see the
   * bug this replaced: content inside a closed <details> still reports a
   * non-zero box. Use `checkVisibility()` for what is on screen, and an ARIA
   * snapshot in WebKit specifically for what a screen reader gets — they
   * disagreed here, and only the second one noticed.
   */
  .toc-static { display: none; }
  @media (min-width: 900px) {
    .toc-disclosure { display: none; }
    .toc-static { display: block; }
  }

  .toc-disclosure > summary {
    /* A control, so it clears the 24 px minimum on BOTH axes, not just width. */
    padding: 7px 10px;
    margin-inline: -10px;
    border-radius: 6px;
    font-size: 14px;
    color: var(--label-secondary);
    cursor: pointer;
  }
  .toc-disclosure > summary:hover { background: var(--raised); color: var(--label); }
  .toc-disclosure[open] > summary { margin-bottom: 8px; }

  .next {
    display: block;
    margin-top: 48px; padding-top: 20px;
    border-top: 1px solid var(--separator);
    text-decoration: none;
  }
  .next-label { display: block; font-size: 13px; color: var(--label-secondary); }
  .next-title { font-weight: 550; }
</style>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orthant-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // The apex only. A Workers Custom Domain creates and manages its own
  // PROXIED DNS record, which is what orthant.app needs.
  //
  // ⚠️ Do not add updates.orthant.app here or anywhere near it. That hostname
  // is GitHub Pages behind a DNS-only (grey cloud) CNAME, it is compiled into
  // every installed copy of the app as SUFeedURL, and proxying it breaks
  // GitHub's certificate issuance. It is served by a different system on
  // purpose.
  //
  // No www: a second custom domain would serve the whole site at a second
  // hostname with no canonical redirect between them.
  "routes": [{ "pattern": "orthant.app", "custom_domain": true }],
  "assets": {
    // Assets are served directly, without invoking the Worker. That is faster
    // and cheaper, and it is why page security headers come from
    // public/_headers rather than from Worker code.
    //
    // ⚠️ /download is the exception, and it MUST stay one. Asset routing runs
    // BEFORE the Worker, and `not_found_handling: 404-page` answers a
    // navigation request for a path with no asset by serving the 404 page
    // itself — the Worker never runs. /download has no asset behind it, so
    // every visitor who CLICKED the download button got "That page isn't
    // here.", while `curl` got the correct 302: the fallthrough to the Worker
    // happens for non-HTML requests, and curl sends `Accept: */*`.
    //
    // So every header-less check of this route reported success while the
    // route was broken for its only real audience. Verified in both
    // directions after this change, with and without `Accept: text/html`.
    "run_worker_first": ["/download", "/download/"],
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
